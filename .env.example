# 既存の Gemini 設定。LLM_PROVIDER 未指定時はこのキーを優先する。
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# OpenAI を使う場合は LLM_PROVIDER=openai に変更する。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MCP サーバーや定期同期から使う場合は絶対パスにする
DB_PATH=./symnote.db
SUMMARY_TARGET_SENTENCES=3
MAX_TOKENS=4096
# Google Calendar (optional). Create a Desktop OAuth client in Google Cloud,
# enable the Google Calendar API, then set the downloaded client JSON path.
GOOGLE_CALENDAR_CLIENT_SECRET_PATH=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REMINDER_MINUTES=30
GOOGLE_CALENDAR_TIMEZONE=Asia/Tokyo
GOOGLE_CALENDAR_DEADLINE_HOUR=9
# 朝のまとめ予定の時刻（当日分のみ作成）。アプリを開かない日も届けるには
# README の launchd 設定で symnote.calendar_sync を定期実行する。
GOOGLE_CALENDAR_MORNING_DIGEST_HOUR=8
# claude.ai から使うリモート MCP（任意）。README の「claude.ai から使う（リモート接続）」参照。
# 公開 URL は Cloudflare Tunnel などで割り当てた https://ホスト名（パスなし）。
SYMNOTE_MCP_PUBLIC_URL=
# 同意画面で入力するパスフレーズ（12 文字以上）。漏れたら変更し --revoke-all を実行する。
SYMNOTE_MCP_PASSPHRASE=
SYMNOTE_MCP_PORT=8765
