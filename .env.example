LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DB_PATH=./symnote.db
SUMMARY_TARGET_SENTENCES=3
MAX_TOKENS=4096
# Google Calendar (optional). Create a Desktop OAuth client in Google Cloud,
# enable the Google Calendar API, then set the downloaded client JSON path.
GOOGLE_CALENDAR_CLIENT_SECRET_PATH=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REMINDER_MINUTES=30
GOOGLE_CALENDAR_TIMEZONE=Asia/Tokyo
GOOGLE_CALENDAR_DEADLINE_HOUR=9
# Morning task digest sent through Google Calendar.  A rolling snapshot is
# created on each successful SymNote sync so Calendar can notify your phone
# even while this PC is off.
GOOGLE_CALENDAR_MORNING_DIGEST_HOUR=8
GOOGLE_CALENDAR_MORNING_DIGEST_LOOKAHEAD_DAYS=31
