{
  "name": "symnote-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:add": "npm run build && cap add ios",
    "test:device": "node --test tests/*.test.ts",
    "ios:build:simulator": "npm run ios:sync && node scripts/build-ios.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
