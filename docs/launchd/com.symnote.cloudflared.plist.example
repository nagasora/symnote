<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cloudflare Tunnel（cloudflared）常駐用 launchd 設定例

  設置手順:
    1. パス内の YOUR_USERNAME をご自身の Mac ユーザー名に書き換える
    2. ~/Library/LaunchAgents/com.symnote.cloudflared.plist にコピーする
    3. launchctl load -w ~/Library/LaunchAgents/com.symnote.cloudflared.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.symnote.cloudflared</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/YOUR_USERNAME/.cloudflared/config.yml</string>
    <string>run</string>
    <string>symnote</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/symnote-cloudflared.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/symnote-cloudflared.err.log</string>
</dict>
</plist>
